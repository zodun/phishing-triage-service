# Copy to .env in the repository root. Never commit the populated .env.
WORKSPACE_PORT=8089
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8089/auth/google/callback

# Server-side invoice reader configuration (DeepSeek example).
INVOICE_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
INVOICE_MODEL=deepseek-chat
# Alternative: INVOICE_MODEL_PROVIDER=openai, OPENAI_API_KEY, INVOICE_MODEL
OPENAI_API_KEY=
